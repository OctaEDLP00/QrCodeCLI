{
	"compilerOptions": {
		"target": "ESNext",
		"module": "node20",
		"outDir": "./dist",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"useDefineForClassFields": true,
		"noImplicitAny": true,
		"resolveJsonModule": true,
		"rootDir": "."
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "test/*.{test,spec}.ts"]
}

{
	"name": "@qrx/qrcode-cli",
	"version": "0.0.1",
	"description": "",
	"keywords": [
		"builder",
		"cli",
		"installer",
		"readline",
		"typescript"
	],
	"homepage": "https://github.com/OctaEDLP00/QrCodeCLI#readme",
	"bugs": {
		"url": "https://github.com/OctaEDLP00/QrCodeCLI/issues"
	},
	"license": "MIT",
	"author": "OctaEDLP00",
	"repository": {
		"type": "git",
		"url": "https://github.com/OctaEDLP00/QrCodeCLI.git"
	},
	"bin": "dist/cli.js",
	"files": [
		"dist/cli.js",
		"dist/README.md",
		"dist/LICENSE",
		"dist/package.json",
		"dist/tsconfig.json"
	],
	"type": "module",
	"types": "./index.d.ts",
	"scripts": {
		"build": "tsup",
		"lint": "oxlint src/**/*.ts",
		"lint:fix": "oxlint src/**/*.ts --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"prepublishOnly": "pnpm run build && pnpm run test:run && pnpm run lint",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"commander": "14.0.2"
	},
	"devDependencies": {
		"@types/node": "25.0.10",
		"@vitest/coverage-v8": "4.0.18",
		"@vitest/ui": "4.0.18",
		"oxfmt": "^0.27.0",
		"oxlint": "1.42.0",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
